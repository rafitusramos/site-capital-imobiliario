NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fase 1 de medição (Google Ads / Meta Ads) — ver components/analytics/Tags.tsx.
# Cada uma é opcional: se ausente, a tag correspondente simplesmente não carrega.
NEXT_PUBLIC_GA4_ID=G-N5PFHEHGZ6
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Fase 5: e-mails de lead (Resend). Somente servidor, nunca NEXT_PUBLIC.
# Sem RESEND_API_KEY o envio vira no-op silencioso (loga uma vez).
RESEND_API_KEY=
EMAIL_REMETENTE="RT Capital Imobiliário <contato@rtcapitalimobiliario.com.br>"
EMAIL_ADMIN=

# Simulação de financiamento (PDF no servidor). Só para rodar a rota FORA da Vercel:
# caminho de um Chrome/Chromium local. Na Vercel fica vazio (usa @sparticuz/chromium).
SIMULACAO_CHROME_PATH=

# Instagram comentário -> DM (/api/meta/*). Só servidor, nunca NEXT_PUBLIC. Só o ambiente
# Production da Vercel deve tê-las: se QUALQUER uma faltar, as rotas respondem 503 e não enviam nada.
# ID do app no painel da Meta (Configurações do app > Básico).
META_APP_ID=
# Chave secreta do app (mesma tela). Também valida a assinatura X-Hub-Signature-256 do webhook.
META_APP_SECRET=
# ID da configuração do login unificado (Login para Empresas > Configurações). Não é segredo.
META_LOGIN_CONFIG_ID=
# Texto qualquer que você inventa; o mesmo valor vai no campo "Verificar token" do webhook na Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Segredo que o pg_cron manda em /api/meta/disparar/. Tem de ser IGUAL ao segredo `ig_cron_secret` do Vault do Supabase.
CRON_SECRET=
