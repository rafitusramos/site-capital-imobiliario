# Copie para .env.e2e.local (ignorado pelo git) e preencha.
#
# URL do deploy a testar, sem barra final. Também pode vir do ambiente:
#   E2E_BASE_URL=https://<deploy>.vercel.app npm run e2e
E2E_BASE_URL=

# Usuário de QA DEDICADO (criado no Supabase Auth, papel definido pelo dono).
# NUNCA use a conta do dono aqui. Sem estas duas variáveis, os specs de admin
# são pulados com o motivo "sem usuário de QA (.env.e2e.local)".
E2E_EMAIL=
E2E_SENHA=
